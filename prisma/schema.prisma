// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 1. USERS ────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(SALES_REP)
  status    Status   @default(ACTIVE)
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Reporting hierarchy — self-relation. A user has at most one manager,
  // and can have many direct reports. Depth is intentionally ONE LEVEL only
  // (direct reports, not the full recursive subtree) — see Tasks module's
  // /api/users/assignable route for where this gets enforced.
  manager       User?  @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports User[] @relation("ManagerHierarchy")

  // Relations
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  taskActivities TaskActivity[]
  followUps      FollowUp[]
  leadHistory    LeadHistory[]

  @@map("users")
}

// ─── 2. COMPANIES ────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  companyName String   @map("company_name")
  industry    String?
  website     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  contacts Contact[]

  @@map("companies")
}

// ─── 3. CONTACTS ─────────────────────────────────────────────────────────────

model Contact {
  id          String        @id @default(cuid())
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  email       String        @unique
  phone       String?
  companyId   String?       @map("company_id")
  location    String?
  leadStatus  LeadStatus    @default(WARM) @map("lead_status")
  isFavourite Boolean       @default(false) @map("is_favourite")
  ownerId     String        @map("owner_id")
  status      ContactStatus @default(ACTIVE) // lifecycle: kept alongside leadStatus
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // ─── Lead lifecycle — added for the Dashboard's Lead Insights tab ─────────
  // These are a THIRD axis on a contact, alongside `status` (lifecycle) and
  // `leadStatus` (Hot/Warm/Cold sales temperature). None of the Lead Insights
  // KPI cards could be answered from those two: "Fresh", "Converted" etc. are
  // pipeline positions, not temperatures, so they get their own enum rather
  // than overloading one that already means something else.
  //
  // stage/source are deliberately SEPARATE fields: "Referred" describes where
  // a lead came from and can be true of a lead at any stage, so folding it
  // into the stage enum would make a referred-and-converted lead impossible
  // to represent.
  leadStage  LeadStage  @default(FRESH) @map("lead_stage")
  leadSource LeadSource @default(DIRECT) @map("lead_source")

  // "Revived" and "Re-Enquired" are transition counters, not states — a lead
  // that was closed and later reopened is still sitting at some stage, so
  // neither can live in the stage enum either. revivedAt doubles as the
  // timestamp the Lead Insights date filter uses for the Revived card.
  revivedAt      DateTime? @map("revived_at")
  reEnquiryCount Int       @default(0) @map("re_enquiry_count")

  // ─── Lead desk — added for the Leads module ───────────────────────────────
  // subStatus is the SECOND level of leadStage, not a replacement for it: a
  // lead at stage FRESH can be Untouched or already Contacted, and both still
  // count on the "Fresh Leads" KPI card. Which sub-statuses are legal for a
  // given stage is enforced at the API layer (lib/leads.ts), not by the DB —
  // the pairing is a business rule that changes far more often than a schema
  // migration should.
  leadSubStatus LeadSubStatus @default(UNTOUCHED) @map("lead_sub_status")

  // 0–100, validated at the API layer. Stored rather than computed because
  // agents override it by hand; a derived score would silently discard that.
  leadScore Int @default(0) @map("lead_score")

  // The SPECIFIC origin ("The Tribune", "Feb Webinar") as free text, next to
  // the coarse leadSource enum it belongs to. Kept separate so the Source
  // filter stays a fixed dropdown while the name stays open-ended — turning
  // every new campaign name into an enum value would need a migration each
  // time.
  sourceName String? @map("source_name")

  // Relations
  owner         User           @relation(fields: [ownerId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  deals         Deal[]
  taskAttendees TaskAttendee[] // meeting attendance, via Tasks module
  followUps     FollowUp[]
  history       LeadHistory[]

  // Indexes — per story's performance section, plus the lead-lifecycle
  // columns the Lead Insights KPI counts group by.
  @@index([email])
  @@index([companyId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([firstName])
  @@index([lastName])
  @@index([leadStage])
  @@index([leadSource])
  @@index([revivedAt])
  @@index([leadSubStatus])
  @@index([leadScore])
  @@map("contacts")
}

// ─── 4. DEALS ────────────────────────────────────────────────────────────────

model Deal {
  id                String     @id @default(cuid())
  title             String
  contactId         String     @map("contact_id")
  ownerId           String     @map("owner_id")
  amount            Decimal    @db.Decimal(12, 2)
  stage             DealStage  @default(QUALIFICATION)
  status            DealStatus @default(OPEN)
  probability       Int        @default(0) // 0–100, validated at the API layer (see deals/pipeline route)
  expectedCloseDate DateTime?  @map("expected_close_date")
  // Set automatically when a deal's stage moves to CLOSED_WON (see
  // deals/[id]/stage route) — added for Analytics' Sales Cycle KPI and
  // Revenue Trend graph, neither of which can be computed without knowing
  // WHEN a deal actually closed, not just when it was created.
  closedAt          DateTime?  @map("closed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  contact   Contact    @relation(fields: [contactId], references: [id])
  owner     User       @relation(fields: [ownerId], references: [id])
  tasks     Task[] // tasks optionally linked via Task.relatedDealId
  followUps FollowUp[]

  // Indexes — per Deals Pipeline story's performance section, plus
  // closedAt/amount added for Analytics & Reports
  @@index([ownerId])
  @@index([contactId])
  @@index([stage])
  @@index([status])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@index([closedAt])
  @@index([amount])
  @@map("deals")
}

// ─── 5. ACTIVITIES ───────────────────────────────────────────────────────────
// entityId is polymorphic — it can reference a Deal, Contact, Task, or User.
// Because it points to multiple tables, we intentionally do NOT add a Prisma
// relation or a database FK here. Lookups are done in application code.

model Activity {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  activityType ActivityType @map("activity_type")
  entityType   EntityType   @map("entity_type")
  entityId     String       @map("entity_id") // no FK — polymorphic reference
  message      String
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("activities")
}

// ─── 6. TASKS ────────────────────────────────────────────────────────────────

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  // "type" distinguishes a plain task from one that carries meeting details
  // (TaskActivity rows + TaskAttendee rows). Not in the story's column list
  // explicitly — added so the frontend can filter "show me my meetings"
  // without inferring it from whether related rows happen to exist.
  type          TaskType     @default(STANDARD)
  dueDate       DateTime?    @map("due_date")
  relatedDealId String?      @map("related_deal_id")
  assignedTo    String       @map("assigned_to")
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations — two separate User relations (who it's assigned to vs. who
  // created it) require explicit relation names since Prisma can't infer
  // which foreign key maps to which relation when there's more than one
  // path between the same two models.
  assignee    User           @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator     User           @relation("TaskCreator", fields: [createdBy], references: [id])
  relatedDeal Deal?          @relation(fields: [relatedDealId], references: [id])
  activities  TaskActivity[]
  attendees   TaskAttendee[]

  // Indexes — per story's performance section
  @@index([assignedTo])
  @@index([createdBy])
  @@index([status])
  @@index([dueDate])
  @@index([relatedDealId])
  @@map("tasks")
}

// ─── 7. TASK ACTIVITIES ──────────────────────────────────────────────────────
// Renamed from the story's "Activities" table to avoid colliding with the
// PRE-EXISTING `Activity` model (dashboard's audit-log / Recent Activity
// feed — a completely different concept that happens to share a name in
// the story documents). This table holds meeting/call/follow-up DETAILS
// attached to a specific task; the original `Activity` model is untouched.

model TaskActivity {
  id           String           @id @default(cuid())
  taskId       String           @map("task_id")
  activityType TaskActivityType @map("activity_type")
  meetingDate  DateTime?        @map("meeting_date")
  meetingTime  String?          @map("meeting_time") // stored as "HH:mm" — kept as a simple string since the story treats date/time as separate fields
  location     String?
  notes        String?
  createdBy    String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  // Relations
  task    Task @relation(fields: [taskId], references: [id])
  creator User @relation(fields: [createdBy], references: [id])

  @@index([taskId])
  @@map("task_activities")
}

// ─── 8. TASK ATTENDEES ────────────────────────────────────────────────────────
// Join table — a task (if it's a meeting) can have many attendees, and a
// contact can be an attendee on many different tasks/meetings over time.

model TaskAttendee {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  contactId String   @map("contact_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task    Task    @relation(fields: [taskId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id])

  // Prevents adding the same contact as an attendee on the same task twice
  @@unique([taskId, contactId])
  @@index([taskId])
  @@index([contactId])
  @@map("task_attendees")
}

// ─── 9. FOLLOW-UPS ───────────────────────────────────────────────────────────
// Added for the Dashboard's Follow-Up Insights tab. Deliberately its OWN
// table rather than another TaskType, because a follow-up and a to-do answer
// different questions: a task is work assigned to a user, a follow-up is a
// scheduled touchpoint with a contact that has an outcome (did they pick up?
// were they interested?). Folding them together would mean every Follow-Up
// KPI count silently included unrelated to-dos, and the Tasks list would fill
// up with call reminders.
//
// Kept separate from TaskActivity (activityType FOLLOW_UP) too — those rows
// are descriptive notes hanging off a task and carry no status or completion
// of their own, so Pending/Completed/Overdue can't be computed from them.

model FollowUp {
  id          String           @id @default(cuid())
  contactId   String           @map("contact_id")
  dealId      String?          @map("deal_id") // optional — not every follow-up is about a deal
  ownerId     String           @map("owner_id")
  scheduledAt DateTime         @map("scheduled_at")
  completedAt DateTime?        @map("completed_at")
  status      FollowUpStatus   @default(PENDING)
  outcome     FollowUpOutcome? // only meaningful once completed
  notes       String?

  // Counter rather than a RESCHEDULED status — a follow-up that was moved
  // twice and then completed is still Completed; the reschedules are history,
  // not the current state. Keeping them as a status would make the Rescheduled
  // and Completed cards mutually exclusive, which isn't what they mean.
  rescheduleCount Int @default(0) @map("reschedule_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  contact Contact @relation(fields: [contactId], references: [id])
  deal    Deal?   @relation(fields: [dealId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  // Indexes — every Follow-Up Insights KPI filters on owner + one of
  // status/scheduledAt, and the trend graph buckets by scheduledAt.
  @@index([contactId])
  @@index([dealId])
  @@index([ownerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([completedAt])
  @@map("follow_ups")
}

// ─── 10. LEAD HISTORY ────────────────────────────────────────────────────────
// The Leads module's "complete history" — one row per thing that ever happened
// to a lead, rendered as a single timeline in the lead detail view.
//
// Deliberately NOT the pre-existing `Activity` model. Activity is the
// dashboard's cross-entity feed: it stores one free-text `message` and nothing
// else, so it can answer "what happened recently" but not "what was this
// lead's status before the change, and who changed it". The Assignment Trail
// and the status timeline both need the before/after pair, and the remark
// captured at a status change has to hang off that exact transition rather
// than float beside it. Structured from/to columns are what make that
// possible; reusing Activity would mean parsing English out of a string.
//
// `type` rather than separate tables for remarks/assignments/status changes:
// they are all "an entry in this lead's timeline", ordered together and read
// together. Splitting them would mean three queries and a merge-sort in JS
// every time the detail view opens.
model LeadHistory {
  id        String          @id @default(cuid())
  contactId String          @map("contact_id")
  // Who performed it. No FK to a "system" user — every entry here is caused
  // by a real authenticated request.
  userId    String          @map("user_id")
  type      LeadHistoryType

  // Before/after, as display labels rather than raw enum values, so the
  // timeline stays readable even if an enum is later renamed. Null on entry
  // types that have no transition (a plain remark, say).
  fromValue String? @map("from_value")
  toValue   String? @map("to_value")

  // The "lead recording" an agent is prompted for whenever status changes —
  // required by the status route, optional everywhere else.
  remark String?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  // Composite index — the detail view always reads one lead's entries newest
  // first, which a single-column index on contactId alone would still make
  // sort in memory.
  @@index([contactId, createdAt])
  @@index([type])
  @@map("lead_history")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  SALES_REP
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  LEAD
}

// Sales temperature — separate axis from ContactStatus (lifecycle).
// Story's "Lead Status" section: Hot / Warm / Cold, enforced at DB level.
enum LeadStatus {
  HOT
  WARM
  COLD
}

// Where a lead currently sits in its lifecycle — the axis the Lead Insights
// KPI cards count by. Mutually exclusive by design: a lead is at exactly one
// of these at any moment.
enum LeadStage {
  FRESH
  INTERESTED
  CONVERTED
  CLOSED
  IRRELEVANT
}

// Where the lead came from. REFERRAL is what the "Referred Leads" card counts.
enum LeadSource {
  DIRECT
  REFERRAL
  WEBSITE
  CAMPAIGN
  EVENT
  OTHER
}

// Second level under LeadStage. One flat enum rather than one enum per stage,
// because Prisma can't express "this column's legal values depend on that
// column" — the stage→sub-status pairing is enforced in lib/leads.ts instead,
// which is also where the Sub-Status dropdown gets its options from, so the
// UI and the validation can never disagree about which pairs are legal.
enum LeadSubStatus {
  // FRESH
  UNTOUCHED
  CONTACTED
  NOT_REACHABLE
  // INTERESTED
  CALLBACK_REQUESTED
  PROPOSAL_SENT
  NEGOTIATING
  // CONVERTED
  WON
  // CLOSED
  LOST
  DROPPED
  // IRRELEVANT
  JUNK
  DUPLICATE
  OUT_OF_AREA
}

// What a LeadHistory row records. CREATED is written once at lead creation so
// every timeline has a beginning rather than starting mid-story.
enum LeadHistoryType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  REMARK_ADDED
  DETAILS_UPDATED
  FOLLOW_UP_SCHEDULED
}

// MISSED vs CANCELLED: a missed follow-up is one whose time passed without
// being actioned; a cancelled one was called off deliberately. A PENDING one
// whose scheduledAt is simply in the past is "Overdue", and one still in the
// future is "Planned" — both DERIVED at query time from status + scheduledAt
// rather than stored, so they can't drift out of date the way a stored flag
// would the moment the clock passes it.
enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum FollowUpOutcome {
  CONNECTED
  NOT_CONNECTED
  INTERESTED
  NOT_INTERESTED
  CALLBACK_REQUESTED
  CONVERTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
}

enum ActivityType {
  DEAL_CREATED
  DEAL_UPDATED
  MEETING_SCHEDULED
  CONTACT_UPDATED
  EMAIL_SENT
  TASK_COMPLETED
  NOTE_ADDED
}

enum EntityType {
  DEAL
  CONTACT
  TASK
  USER
}

// TaskStatus renamed from the original PENDING/IN_PROGRESS/COMPLETED/CANCELLED
// to match this story's exact spec (TODO/IN_PROGRESS/COMPLETED). CANCELLED
// was intentionally dropped rather than assumed — flagged as reversible if
// a "cancelled" state turns out to be needed later.
enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

// Distinguishes a plain task from a meeting-carrying one — see the note on
// Task.type above for why this is explicit rather than inferred.
enum TaskType {
  STANDARD
  MEETING
}

enum TaskActivityType {
  MEETING
  CALL
  FOLLOW_UP
}
